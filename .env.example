# ---------------------------------------------------------------
# copia este archivo a .env y completa los valores.
# .env esta en .gitignore: nunca lo subas al repo.
# ---------------------------------------------------------------

# --- identidad del bot ---
BOT_NAME=Chat Contest

# URL publica del leaderboard, que el bot cita en sus mensajes
WEB_URL=https://contest.itb.lat

# jid del grupo donde se publican los problemas.
# lo obtenes corriendo el bot y mandando !jid en el grupo.
GRUPO_JID=

# numeros de admin separados por coma, sin + ni espacios (ej: 5491122334455)
ADMINS=

# --- core (python) ---
CORE_HOST=127.0.0.1
CORE_PORT=8000
# token compartido entre el bot y el core. generalo con: openssl rand -hex 32
CORE_TOKEN=
DB_PATH=var/contest.db

# --- IA: build.nvidia.com (API compatible con OpenAI) ---
NVIDIA_API_KEY=
NVIDIA_BASE_URL=https://integrate.api.nvidia.com/v1
# Si se satura, el core prueba solo con los suplentes (ver MODELOS_SUPLENTES en
# config.py). Dejalo vacio para usar el que viene por defecto.
NVIDIA_MODEL=z-ai/glm-5.2
NVIDIA_MODELOS_SUPLENTES=

# --- juez ---
# docker (produccion, aislado de verdad) o subprocess (solo desarrollo local)
JUDGE_BACKEND=docker
JUDGE_IMAGE=chat-contest-judge:latest
JUDGE_TIMEOUT_MS=5000
JUDGE_MEMORY_MB=256
JUDGE_MAX_SOURCE_BYTES=65536
# multiplica el limite de tiempo de todos los problemas, para compensar
# que este servidor sea mas lento que la maquina donde se calibraron.
# medilo con: python -m contest.cli calibrar
JUDGE_TIME_FACTOR=1.0

# --- rondas ---
# cada cuantos dias se publica una ronda nueva
RONDA_CADA_DIAS=3
# hora local de publicacion (24h)
RONDA_HORA=18
RONDA_TZ=America/Argentina/Buenos_Aires
# cuantos problemas por ronda y de que dificultades
RONDA_DIFICULTADES=1,3,5

# --- anti trampa ---
# segundos minimos entre dos entregas del mismo usuario
COOLDOWN_ENTREGA_SEG=45
# maximo de entregas por problema por usuario
MAX_INTENTOS=12
# umbral de similitud (0-1) a partir del cual se marca para revision
SIMILITUD_UMBRAL=0.82
